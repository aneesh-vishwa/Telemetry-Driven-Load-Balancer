{
  "port": 8443,
  "apiPort": 9000,
  "serverPools": [
    {
      "name": "api_servers_stable",
      "servers": [
        "http://host.docker.internal:3001",
        "http://host.docker.internal:3002"
      ]
    },
    {
      "name": "api_servers_canary",
      "servers": [
        "http://host.docker.internal:3005"
      ]
    },
    {
      "name": "web_servers",
      "servers": [
        "http://host.docker.internal:3003"
      ]
    }
  ],
  "routingRules": [
    {
      "path": "/api",
      "pools": [
        { "name": "api_servers_stable", "weight": 95 },
        { "name": "api_servers_canary", "weight": 5 }
      ]
    }
  ],
  "defaultPool": "web_servers"
}