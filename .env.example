# Load Balancer Configuration
PORT=8443
API_PORT=9000

# TLS/SSL Certificates
TLS_KEY_PATH=/usr/src/app/server.key
TLS_CERT_PATH=/usr/src/app/server.crt

# Redis Configuration
REDIS_URL=redis://redis:6379

# MongoDB Configuration
MONGO_USER=user
MONGO_PASSWORD=password
MONGO_URI=mongodb://user:password@mongo:27017/admin

# Node Environment
NODE_ENV=development
NODE_TLS_REJECT_UNAUTHORIZED=0
